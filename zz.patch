+    function _settleNet(Currency c, uint256 owed, uint256 credit) private {
+        if (owed > credit) {
+            poolManager.sync(c);
+            c.transfer(address(poolManager), owed - credit);
+            poolManager.settle();
+        } else if (credit > owed) {
+            poolManager.take(c, address(this), credit - owed);
+        }
     }
+
+    // ------------------------------------------------------------------
 }
