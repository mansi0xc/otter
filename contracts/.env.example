# Copy to contracts/.env and replace only PRIVATE_KEY before broadcasting.
# Do not commit the resulting .env file.
SEPOLIA_RPC_URL=
# Include the 0x prefix, for example: PRIVATE_KEY=0xabc123...
PRIVATE_KEY=

# Official Uniswap v4 PoolManager on Ethereum Sepolia.
POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543

# Leave SOLVER unset to use the deploying wallet for the demo. For a relayer,
# set it to the address of a separately funded operational wallet.
# SOLVER=

# Demo parameters (all optional; the shown values are contract defaults).
WINDOW=60
EXCLUSIVITY_WINDOW=300
REFUND_DELAY=900
LIQUIDITY=1000000000000000000000

# Leave token addresses unset to deploy two test tokens and mint initial liquidity.
# TOKEN0=
# TOKEN1=

# Required only if you add --verify to the forge script command.
# ETHERSCAN_API_KEY=
